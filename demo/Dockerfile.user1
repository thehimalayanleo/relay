FROM node:22-alpine

WORKDIR /opt/relay

COPY bin/relay.mjs ./bin/relay.mjs
COPY demo/user1-entrypoint.sh ./demo/user1-entrypoint.sh
COPY demo/arc-agi-3-scenario.json ./demo/arc-agi-3-scenario.json

RUN chmod +x ./bin/relay.mjs ./demo/user1-entrypoint.sh

ENV RELAY_SERVER=http://host.docker.internal:4317 \
    RELAY_RECEIVER_ORIGIN=http://127.0.0.1:4317 \
    RELAY_DEMO_OUT=/demo/out

ENTRYPOINT ["./demo/user1-entrypoint.sh"]
